# Deployer configuration (read by docker compose from deploy/.env).
#
# The Windows installer generates the real .env with cryptographically random secrets on YOUR
# machine. The values below are placeholders for local development only - never use them on an
# installation that other people or devices can reach.
#
# Generate your own on Linux/macOS/Git Bash:
#   openssl rand -hex 24        (passwords / JWT secret)
#   openssl rand -base64 32     (MASTER_KEY)

# --- Public address ---------------------------------------------------------------------------
# The URL people use to open Deployer. OAuth callback URLs are derived from it:
#   <PUBLIC_URL>/v1/auth/oauth/google/callback and <PUBLIC_URL>/v1/auth/oauth/github/callback
# The instance owner can change it later in the dashboard (Instance settings).
PUBLIC_URL=http://localhost:8080

# Host port and bind address for Caddy. 127.0.0.1 = this PC only; 0.0.0.0 = all interfaces
# (LAN access, still subject to the Windows firewall).
DEPLOYER_HTTP_PORT=8080
DEPLOYER_BIND=127.0.0.1

# --- Images -------------------------------------------------------------------------------------
# Images are pulled from <prefix>-api, <prefix>-dashboard and <prefix>-tunnel. Forks publish to their
# own GHCR owner.
DEPLOYER_IMAGE_PREFIX=ghcr.io/nyx-ulrix/deployer
# A release version without the leading "v" (e.g. 0.1.0), or "latest".
DEPLOYER_VERSION=latest
# Where `docker compose build` finds api/, dashboard/ and deploy/tunnel/, relative to this directory.
# ".." in a git checkout; the installer uses "./src".
DEPLOYER_SOURCE_DIR=..

# --- Optional services -----------------------------------------------------------------------
# "mongodb" starts the managed MongoDB 5.0 container (needs a CPU with AVX). Leave empty on CPUs
# without AVX and set MANAGED_MONGODB_ENABLED=false; projects can still attach an external
# MongoDB such as a free MongoDB Atlas cluster.
COMPOSE_PROFILES=mongodb
MANAGED_MONGODB_ENABLED=true

# --- MariaDB (platform metadata + managed SQL databases) ----------------------------------------
MARIADB_DATABASE=deployer
MARIADB_USER=deployer
MARIADB_PASSWORD=dev-only-change-me-mariadb
# Root is used by the API to create a database + restricted user per managed data source.
MARIADB_ROOT_PASSWORD=dev-only-change-me-mariadb-root

# --- MongoDB (managed NoSQL databases) ----------------------------------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=dev-only-change-me-mongo

# --- Redis (OAuth state, rate limits, job queue) ------------------------------------------------
# Letters and digits only (it is embedded in the redis:// URL).
REDIS_PASSWORD=devonlychangemeredis

# --- API secrets ----------------------------------------------------------------------------------
# Signs access tokens. Changing it signs everyone out.
JWT_SECRET=dev-only-change-me-jwt-secret-at-least-32-characters
# base64 of exactly 32 random bytes. Encrypts OAuth client secrets and external database passwords
# stored in MariaDB. BACK IT UP: without it those stored secrets cannot be decrypted.
MASTER_KEY=replace-me-run-openssl-rand-base64-32

# --- Sign-in options (optional) -------------------------------------------------------------------
# Leave empty and configure your own OAuth apps in the setup wizard instead. Deployer ships with no
# OAuth apps of its own. These env values are only initial defaults.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Allow anyone who can reach the dashboard to create an account (otherwise invite-only).
ALLOW_SIGNUP=false

# --- Memory limits (docker mem_limit syntax) ------------------------------------------------------
MARIADB_MEM_LIMIT=512m
MONGODB_MEM_LIMIT=512m
REDIS_MEM_LIMIT=160m
API_MEM_LIMIT=768m
WORKER_MEM_LIMIT=384m
DASHBOARD_MEM_LIMIT=64m
CADDY_MEM_LIMIT=128m
TUNNEL_MEM_LIMIT=128m
# Cloudflare tunnel transport: http2 (TCP 443, works behind any router) or auto/quic (UDP 7844).
TUNNEL_PROTOCOL=http2
# Each deployed app container (docs/DEPLOYMENTS.md). Apps are reachable on ports 8100-8199, bound
# like DEPLOYER_BIND above.
APP_MEM_LIMIT=512m
